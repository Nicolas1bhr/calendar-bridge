# Calendar Bridge settings. Everything is optional: the defaults work.
#
# Copy this file to .env next to docker-compose.yml (never commit .env), uncomment what you want to
# change, and apply it with `docker compose up -d`. Keep comments on their own lines. A misspelled
# CB_ name is reported, never ignored.
#
# Every setting can also go in config/calendar-bridge.toml, lower case without the CB_ prefix.
# Secrets do NOT belong here: `calendar-bridge setup` stores the Google authorization and the iCloud
# app-specific password encrypted, and the encryption key is the file ./secrets/calendar_bridge_key.

# --- alerts: configure at least one private channel ----------------------------------------------
# Phone notifications with the ntfy app: subscribe to a topic nobody can guess.
# CB_ALERT_NTFY_URL=https://ntfy.sh/calendar-bridge-<random>
# Optional access token for a protected ntfy server, as a file mounted into the container.
# CB_ALERT_NTFY_TOKEN_FILE=/config/ntfy_token
# Generic JSON webhook (Slack, Discord and Mattermost compatible).
# CB_ALERT_WEBHOOK_URL=https://hooks.example.com/...
# E-mail (all of TO, SMTP_HOST and usually SMTP_USER with a password file).
# CB_ALERT_EMAIL_TO=you@example.com
# CB_ALERT_EMAIL_FROM=calendar-bridge@example.com
# CB_ALERT_SMTP_HOST=smtp.example.com
# CB_ALERT_SMTP_PORT=587
# CB_ALERT_SMTP_USER=you@example.com
# CB_ALERT_SMTP_PASSWORD_FILE=/config/smtp_password
# Hours between repeats of an alert that persists.
# CB_ALERT_REPEAT_HOURS=24

# --- monitoring ------------------------------------------------------------------------------------
# Dead-man's switch that alerts you when the bridge stops entirely, e.g. https://hc-ping.com/<uuid>
# CB_HEARTBEAT_URL=
# Alert when no fully successful synchronization happened for this many seconds.
# CB_LAG_ALERT_SECONDS=900
# Publish the status to a "Calendar Bridge Status" calendar in Google (readable by ChatGPT).
# CB_STATUS_CALENDAR=true
# CB_STATUS_CALENDAR_NAME=Calendar Bridge Status

# --- synchronization ------------------------------------------------------------------------------
# Seconds between cycles (minimum 15).
# CB_SYNC_INTERVAL=60
# Seconds between complete re-reads of both calendars.
# CB_FULL_RECONCILE_INTERVAL=21600
# Zone for times that carry none. auto = your Google account's zone, recorded when the first
# calendar pair starts. Choose before setting up calendar pairs; changing it later re-times
# recurring events that have no zone.
# CB_DEFAULT_TIMEZONE=auto
# New calendar pairs leave alone events that ended more than this many days ago; "all" for no limit.
# CB_DEFAULT_HISTORY_DAYS=365
# authoritative | propagate (see docs/semantics.md, meetings).
# CB_MEETING_POLICY=authoritative
# Show the owner's guest list and call links as text in the copy's notes.
# CB_MIRROR_INFO_BLOCK=true
# Special Google event types copied to iCloud.
# CB_MIRROR_GOOGLE_EVENT_TYPES=fromGmail

# --- safety -----------------------------------------------------------------------------------------
# Deletions are held for review when more than max(COUNT, RATIO x events) happen in one cycle.
# CB_MASS_DELETE_COUNT=10
# CB_MASS_DELETE_RATIO=0.2
# Most events handled per cycle (a large first copy spreads over several cycles).
# CB_MAX_ITEMS_PER_CYCLE=500
# Days deleted events can still be restored.
# CB_TOMBSTONE_RETENTION_DAYS=90

# --- logging and backups -----------------------------------------------------------------------------
# CB_LOG_LEVEL=INFO
# json or text
# CB_LOG_FORMAT=json
# CB_BACKUP_INTERVAL_HOURS=24
# CB_BACKUP_KEEP=14
